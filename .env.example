# AI-Minaret — Environment Variables
# Copy to .env and fill in what you use. Nothing here is required to run the
# app — Local and Free-tier providers both work with zero keys configured,
# just with fewer options.

# ── Local model (Ollama / LM Studio / vLLM on this machine or LAN) ────────
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2

# ── Free-tier rotation (lib/free-providers.mjs) ────────────────────────────
# Set any subset — each provider is skipped if its key is missing. More keys
# = more free-tier headroom (each has its own daily rate limit). Get keys at:
#   Groq:        https://console.groq.com/keys
#   OpenRouter:  https://openrouter.ai/keys
#   Gemini:      https://aistudio.google.com/app/apikey
#   Mistral:     https://console.mistral.ai/api-keys
#   NVIDIA NIM:  https://build.nvidia.com/explore/discover
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Optional per-provider model overrides (defaults are set in lib/free-providers.mjs)
# GROQ_MODEL=
# OPENROUTER_MODEL=
# GEMINI_MODEL=
# MISTRAL_MODEL=
# NVIDIA_MODEL=

# ── Server ──────────────────────────────────────────────────────────────
# PORT=3210
